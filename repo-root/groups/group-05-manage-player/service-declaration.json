{
  "serviceId": "group-05-manage-player",
  "name": "Player Management",
  "version": "1.0.0",
  "description": "Service responsable de la création, consultation, mise à jour, suppression logique et synchronisation des joueurs.",
  "owner": {
    "team": "group-05-manage-player",
    "contact": "todo@example.org"
  },
  "repository": {
    "type": "git",
    "url": "git@example.com:org/repo.git",
    "path": "groups/group-05-manage-player"
  },
  "endpoints": [
    {
      "path": "/players",
      "method": "GET",
      "operationId": "getPlayers",
      "description": "Lister les joueurs",
      "responseSchema": "./openapi.yaml#/components/schemas/Player",
      "auth": "ApiKeyAuth"
    },
    {
      "path": "/players",
      "method": "POST",
      "operationId": "createPlayer",
      "description": "Créer un joueur",
      "requestSchema": "./openapi.yaml#/components/schemas/CreatePlayerRequest",
      "responseSchema": "./openapi.yaml#/components/schemas/CreatePlayerResponse",
      "auth": "ApiKeyAuth"
    },
    {
      "path": "/players/{id}",
      "method": "GET",
      "operationId": "getPlayer",
      "description": "Récupérer un joueur",
      "responseSchema": "./openapi.yaml#/components/schemas/Player",
      "auth": "ApiKeyAuth"
    },
    {
      "path": "/players/{id}",
      "method": "PUT",
      "operationId": "updatePlayer",
      "description": "Mettre à jour un joueur",
      "requestSchema": "./openapi.yaml#/components/schemas/UpdatePlayerRequest",
      "responseSchema": "./openapi.yaml#/components/schemas/UpdatePlayerResponse",
      "auth": "ApiKeyAuth"
    },
    {
      "path": "/players/{id}",
      "method": "DELETE",
      "operationId": "deletePlayer",
      "description": "Supprimer logiquement un joueur",
      "responseSchema": "./openapi.yaml#/components/schemas/DeletePlayerResponse",
      "auth": "ApiKeyAuth"
    },
    {
      "path": "/players/{id}/statistics",
      "method": "POST",
      "operationId": "updatePlayerStatistics",
      "description": "Mettre à jour les statistiques d’un joueur",
      "requestSchema": "./openapi.yaml#/components/schemas/UpdatePlayerStatisticsRequest",
      "responseSchema": "./openapi.yaml#/components/schemas/UpdatePlayerStatisticsResponse",
      "auth": "ApiKeyAuth"
    },
    {
      "path": "/events/teams/player-joined",
      "method": "POST",
      "operationId": "playerJoinedTeam",
      "description": "Consommer l'événement PlayerJoinedTeam et associer un joueur à une équipe",
      "auth": "ApiKeyAuth"
    },
    {
      "path": "/events/teams/player-left",
      "method": "POST",
      "operationId": "playerLeftTeam",
      "description": "Consommer l'événement PlayerLeftTeam et retirer un joueur d'une équipe",
      "auth": "ApiKeyAuth"
    }
  ],
  "eventsProduced": [
    {
      "name": "PlayerCreated",
      "schema": "./event/out/PlayerCreated.md",
      "description": "Contrat documenté pour une future publication après création d’un joueur"
    },
    {
      "name": "PlayerNameUpdated",
      "schema": "./event/out/PlayerNameUpdated.md",
      "description": "Contrat documenté pour une future publication après modification du prénom ou du nom"
    },
    {
      "name": "PlayerDeleted",
      "schema": "./event/out/PlayerDeleted.md",
      "description": "Contrat documenté pour une future publication après suppression logique d’un joueur"
    }
  ],
  "eventsConsumed": [
    {
      "name": "PlayerJoinedTeam",
      "schema": "./event/in/team/PlayerJoinedTeam.md",
      "description": "Event consommé via POST /events/teams/player-joined"
    },
    {
      "name": "PlayerLeftTeam",
      "schema": "./event/in/team/PlayerLeftTeam.md",
      "description": "Event consommé via POST /events/teams/player-left"
    },
    {
      "name": "MatchPlayerEvent",
      "schema": "./event/in/match/MatchPlayerEvent.md",
      "description": "Contrat documenté ; l'application utilise aujourd'hui POST /players/{id}/statistics pour le comportement équivalent"
    }
  ],
  "schemas": [
    "./tests/schemas/player.schema.json",
    "./tests/schemas/player-status.schema.json",
    "./tests/schemas/player-statistics.schema.json",
    "./tests/schemas/gender.schema.json",
    "./tests/schemas/height.schema.json",
    "./tests/schemas/team-id.schema.json"
  ],
  "health": {
    "path": "/health",
    "method": "GET",
    "expectedStatus": 200
  },
  "security": {
    "type": "apiKey",
    "in": "header",
    "name": "X-API-KEY"
  },
  "deployment": {
    "image": "registry.example.org/group-05-manage-player:1.0.0",
    "replicas": 2,
    "resources": {
      "cpu": "500m",
      "memory": "512Mi"
    }
  },
  "ci": {
    "validateCommand": "cd groups/group-05-manage-player/manage-player && mvn -DskipTests=false test",
    "lintOpenApi": "spectral lint openapi.yaml"
  },
  "contacts": [
    {
      "role": "PO",
      "name": "TODO PO",
      "email": "po@example.org"
    },
    {
      "role": "Tech lead",
      "name": "TODO TL",
      "email": "tl@example.org"
    }
  ],
  "metadata": {
    "schemaVersion": "1.0",
    "lastUpdated": "2026-03-18"
  }
}
