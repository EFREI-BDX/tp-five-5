{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Business rules not expressible in standard draft-07: wins + losses + draws must be less than or equal to matchesPlayed; mvps must be less than or equal to matchesPlayed.",
  "type": "object",
  "properties": {
    "matchesPlayed": {
      "type": "integer",
      "minimum": 0
    },
    "goalsScored": {
      "type": "integer",
      "minimum": 0
    },
    "assists": {
      "type": "integer",
      "minimum": 0
    },
    "wins": {
      "type": "integer",
      "minimum": 0
    },
    "losses": {
      "type": "integer",
      "minimum": 0
    },
    "draws": {
      "type": "integer",
      "minimum": 0
    },
    "mvps": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": ["matchesPlayed", "goalsScored", "assists", "wins", "losses", "draws", "mvps"],
  "additionalProperties": false
}
