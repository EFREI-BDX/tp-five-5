    {
      "name": "Events - happy path",
      "description": "Executer les requetes dans l'ordre. La requete 01 regenere un nouveau matchId; chaque requete regenere son eventId. La sequence cree un match termine avec un score final 1-0.",
      "item": [
        {
          "name": "01 POST MATCH_STARTED",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{matchStartedEventId}}\",\n  \"matchId\": \"{{matchId}}\",\n  \"type\": \"MATCH_STARTED\",\n  \"occurredAt\": \"2026-04-30T12:00:00Z\",\n  \"matchTime\": {\n    \"minute\": 0,\n    \"second\": 0,\n    \"period\": \"FIRST_HALF\"\n  },\n  \"payload\": {\n    \"homeTeam\": {\n      \"teamId\": \"{{homeTeamId}}\",\n      \"startingPlayers\": [\n        { \"playerId\": \"{{homeGoalkeeperId}}\", \"isGoalkeeper\": true },\n        { \"playerId\": \"{{homePlayerId}}\", \"isGoalkeeper\": false },\n        { \"playerId\": \"{{homeAssistantId}}\", \"isGoalkeeper\": false },\n        { \"playerId\": \"00000000-0000-0000-0000-000000000004\", \"isGoalkeeper\": false },\n        { \"playerId\": \"00000000-0000-0000-0000-000000000005\", \"isGoalkeeper\": false }\n      ]\n    },\n    \"awayTeam\": {\n      \"teamId\": \"{{awayTeamId}}\",\n      \"startingPlayers\": [\n        { \"playerId\": \"{{awayGoalkeeperId}}\", \"isGoalkeeper\": true },\n        { \"playerId\": \"{{awayPlayerId}}\", \"isGoalkeeper\": false },\n        { \"playerId\": \"00000000-0000-0000-0000-000000000008\", \"isGoalkeeper\": false },\n        { \"playerId\": \"00000000-0000-0000-0000-000000000009\", \"isGoalkeeper\": false },\n        { \"playerId\": \"00000000-0000-0000-0000-000000000010\", \"isGoalkeeper\": false }\n      ]\n    },\n    \"scheduledDurationMinutes\": 40\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"matchId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"matchStartedEventId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            }
          ]
