# Manage Field API - IntelliJ HTTP Client tests
#
# Run the application on http://localhost:8080, then run requests from top to bottom.
# Scenario requests store values in IntelliJ global variables, especially:
# - scenarioDate
# - createdReservationId
#
# The sample IDs below come from V2 and V7 Flyway migrations.

@host = http://localhost:8080
@apiKey = epIdFODCVgUX1dHmiisCYCBpWTPZWl8x
@json = application/json

@fieldA = 22222222-2222-4222-8222-222222222221
@fieldC = 22222222-2222-4222-8222-222222222223
@inactiveFieldD = 22222222-2222-4222-8222-222222222224
@maintenanceFieldE = 22222222-2222-4222-8222-222222222225
@fieldF = 22222222-2222-4222-8222-222222222226
@missingField = 22222222-2222-4222-8222-222222229999

@fieldStatusActive = 11111111-1111-4111-8111-111111111111
@fieldStatusInactive = 11111111-1111-4111-8111-111111111112
@fieldStatusMaintenance = 11111111-1111-4111-8111-111111111113
@missingFieldStatus = 11111111-1111-4111-8111-111111119999

@reservationStatusPending = 33333333-3333-4333-8333-333333333331
@reservationStatusConfirmed = 33333333-3333-4333-8333-333333333333
@reservationStatusCancelled = 33333333-3333-4333-8333-333333333334
@missingReservationStatus = 33333333-3333-4333-8333-333333339999
@seedReservationAConfirmed = 44444444-4444-4444-8444-444444444441
@missingReservation = 44444444-4444-4444-8444-444444449999

### 00 - Health is public
# @name health
GET {{host}}/health
Accept: {{json}}

> {%
client.test("health returns 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});

client.test("health body is UP", function() {
  client.assert(response.body.status === "UP", "Expected status UP");
});
%}

### 01 - Protected endpoint rejects missing API key
# @name unauthorizedWithoutApiKey
GET {{host}}/v1/field-statuses
Accept: {{json}}

> {%
client.test("missing API key returns 401", function() {
  client.assert(response.status === 401, "Expected 401, got " + response.status);
});

client.test("missing API key returns Unauthorized error", function() {
  client.assert(response.body.error === "Unauthorized", "Expected Unauthorized error");
});
%}

### 02 - Protected endpoint rejects invalid API key
# @name unauthorizedWithInvalidApiKey
GET {{host}}/v1/field-statuses
Accept: {{json}}
X-API-KEY: invalid-api-key

> {%
client.test("invalid API key returns 401", function() {
  client.assert(response.status === 401, "Expected 401, got " + response.status);
});
%}

### 03 - List field statuses
# @name listFieldStatuses
GET {{host}}/v1/field-statuses
Accept: {{json}}
X-API-KEY: {{apiKey}}

> {%
client.test("field statuses return 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});

client.test("field statuses contain active, inactive and maintenance", function() {
  const codes = response.body.map(status => status.code);
  client.assert(codes.includes("active"), "Missing active field status");
  client.assert(codes.includes("inactive"), "Missing inactive field status");
  client.assert(codes.includes("maintenance"), "Missing maintenance field status");
});
%}

### 04 - List reservation statuses
# @name listReservationStatuses
GET {{host}}/v1/reservation-statuses
Accept: {{json}}
X-API-KEY: {{apiKey}}

> {%
client.test("reservation statuses return 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});

client.test("reservation statuses contain pending, confirmed and cancelled", function() {
  const codes = response.body.map(status => status.code);
  client.assert(codes.includes("pending"), "Missing pending reservation status");
  client.assert(codes.includes("confirmed"), "Missing confirmed reservation status");
  client.assert(codes.includes("cancelled"), "Missing cancelled reservation status");
});
%}

### 05 - Get seeded field detail with status and reservations
# @name getSeededFieldDetail
GET {{host}}/v1/fields/{{fieldA}}
Accept: {{json}}
X-API-KEY: {{apiKey}}

> {%
client.test("field detail returns 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});

client.test("field detail contains field status", function() {
  client.assert(response.body.id === client.variables.file.get("fieldA"), "Unexpected field id");
  client.assert(response.body.status_id === client.variables.file.get("fieldStatusActive"), "Expected active status id");
  client.assert(response.body.status.code === "active", "Expected active status code");
});

client.test("field detail contains reservation statuses", function() {
  client.assert(Array.isArray(response.body.reservations), "Expected reservations array");
  client.assert(response.body.reservations.length >= 2, "Expected seeded reservations");
  client.assert(response.body.reservations.every(reservation => reservation.status && reservation.status.code), "Missing reservation status");
});
%}

### 06 - List seeded field reservations
# @name listSeededFieldReservations
GET {{host}}/v1/fields/{{fieldA}}/reservations
Accept: {{json}}
X-API-KEY: {{apiKey}}

> {%
client.test("field reservations return 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});

client.test("field reservations contain seeded confirmed reservation", function() {
  const reservation = response.body.find(item => item.id === client.variables.file.get("seedReservationAConfirmed"));
  client.assert(reservation !== undefined, "Seeded reservation was not found");
  client.assert(reservation.status.code === "confirmed", "Expected confirmed reservation");
});
%}

### 07 - Availability excludes a field blocked by a seeded reservation
# @name seededAvailabilityWithConflict
GET {{host}}/v1/fields/available?date=2026-05-02&start_time=10:00&end_time=11:30
Accept: {{json}}
X-API-KEY: {{apiKey}}

> {%
client.test("availability returns 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});

client.test("availability excludes Field A because it is already reserved", function() {
  const ids = response.body.map(field => field.id);
  client.assert(!ids.includes(client.variables.file.get("fieldA")), "Field A should not be available");
});

client.test("availability includes Field C because its seeded reservation is cancelled", function() {
  const ids = response.body.map(field => field.id);
  client.assert(ids.includes(client.variables.file.get("fieldC")), "Field C should be available");
});
%}

