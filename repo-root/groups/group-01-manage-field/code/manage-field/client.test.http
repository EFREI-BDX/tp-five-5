});
%}

### 14 - Create a confirmed reservation on a random future date
# @name createConfirmedReservation
< {%
const randomDayOffset = $random.integer(30, 3500);
const scenarioDate = new Date(Date.UTC(2027, 0, 1 + randomDayOffset)).toISOString().substring(0, 10);
request.variables.set("scenarioDate", scenarioDate);
client.global.set("scenarioDate", scenarioDate);
%}
POST {{host}}/v1/fields/{{fieldC}}/reservations
Accept: {{json}}
Content-Type: {{json}}
X-API-KEY: {{apiKey}}

{
  "status_id": "{{reservationStatusConfirmed}}",
  "date": "{{scenarioDate}}",
  "start_time": "10:00",
  "end_time": "11:00"
}

> {%
client.test("reservation creation returns 201", function() {
  client.assert(response.status === 201, "Expected 201, got " + response.status);
});

client.test("created reservation matches request", function() {
  client.assert(response.body.field_id === client.variables.file.get("fieldC"), "Unexpected field id");
  client.assert(response.body.status_id === client.variables.file.get("reservationStatusConfirmed"), "Unexpected status id");
  client.assert(response.body.date === client.global.get("scenarioDate"), "Unexpected reservation date");
  client.assert(response.body.start_time === "10:00", "Unexpected start time");
  client.assert(response.body.end_time === "11:00", "Unexpected end time");
});

client.global.set("createdReservationId", response.body.id);
%}

### 15 - Created reservation appears in field reservations
# @name listAfterCreate
GET {{host}}/v1/fields/{{fieldC}}/reservations
Accept: {{json}}
X-API-KEY: {{apiKey}}

> {%
client.test("list after create returns 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});

client.test("list contains the created reservation", function() {
  const createdReservationId = client.global.get("createdReservationId");
  const reservation = response.body.find(item => item.id === createdReservationId);
  client.assert(reservation !== undefined, "Created reservation was not found");
  client.assert(reservation.status.code === "confirmed", "Expected confirmed reservation");
});
%}

### 16 - Overlapping reservation is rejected
# @name createOverlappingReservation
POST {{host}}/v1/fields/{{fieldC}}/reservations
Accept: {{json}}
Content-Type: {{json}}
X-API-KEY: {{apiKey}}

{
  "status_id": "{{reservationStatusPending}}",
  "date": "{{scenarioDate}}",
  "start_time": "10:30",
  "end_time": "11:30"
}

> {%
client.test("overlapping reservation returns 409", function() {
  client.assert(response.status === 409, "Expected 409, got " + response.status);
});

client.test("overlap returns Conflict", function() {
  client.assert(response.body.error === "Conflict", "Expected Conflict");
  client.assert(response.body.message === "reservation overlaps an active reservation", "Unexpected conflict message");
});
%}

### 17 - Availability excludes the field while the reservation is confirmed
# @name availabilityAfterCreate
GET {{host}}/v1/fields/available?date={{scenarioDate}}&start_time=10:00&end_time=11:00
Accept: {{json}}
X-API-KEY: {{apiKey}}

> {%
client.test("availability after create returns 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});

client.test("created reservation blocks Field C", function() {
  const ids = response.body.map(field => field.id);
  client.assert(!ids.includes(client.variables.file.get("fieldC")), "Field C should be blocked");
});
%}

### 18 - Cancel the created reservation
# @name cancelCreatedReservation
PATCH {{host}}/v1/fields/{{fieldC}}/reservations/{{createdReservationId}}/status
Accept: {{json}}
Content-Type: {{json}}
X-API-KEY: {{apiKey}}

{
  "status_id": "{{reservationStatusCancelled}}"
}

> {%
client.test("reservation cancellation returns 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});

client.test("reservation status is cancelled", function() {
  client.assert(response.body.id === client.global.get("createdReservationId"), "Unexpected reservation id");
  client.assert(response.body.status_id === client.variables.file.get("reservationStatusCancelled"), "Expected cancelled status");
  client.assert(response.body.status.code === "cancelled", "Expected cancelled status code");
});
%}

### 19 - Availability includes the field after cancellation
# @name availabilityAfterCancellation
GET {{host}}/v1/fields/available?date={{scenarioDate}}&start_time=10:00&end_time=11:00
Accept: {{json}}
X-API-KEY: {{apiKey}}

> {%
client.test("availability after cancellation returns 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});

client.test("cancelled reservation no longer blocks Field C", function() {
  const ids = response.body.map(field => field.id);
  client.assert(ids.includes(client.variables.file.get("fieldC")), "Field C should be available again");
});
%}

