### 11 - Change field status to maintenance
# @name changeFieldStatusToMaintenance
PATCH {{host}}/v1/fields/{{fieldF}}/status
Accept: {{json}}
Content-Type: {{json}}
X-API-KEY: {{apiKey}}

{
  "status_id": "{{fieldStatusMaintenance}}"
}

> {%
client.test("field status change to maintenance returns 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});

client.test("field status is maintenance", function() {
  client.assert(response.body.id === client.variables.file.get("fieldF"), "Unexpected field id");
  client.assert(response.body.status_id === client.variables.file.get("fieldStatusMaintenance"), "Expected maintenance status");
});
%}

### 12 - Change field status back to active
# @name changeFieldStatusBackToActive
PATCH {{host}}/v1/fields/{{fieldF}}/status
Accept: {{json}}
Content-Type: {{json}}
X-API-KEY: {{apiKey}}

{
  "status_id": "{{fieldStatusActive}}"
}

> {%
client.test("field status change back to active returns 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});

client.test("field status is active again", function() {
  client.assert(response.body.id === client.variables.file.get("fieldF"), "Unexpected field id");
  client.assert(response.body.status_id === client.variables.file.get("fieldStatusActive"), "Expected active status");
});
%}

### 13 - Change field status rejects unknown status
# @name changeFieldStatusUnknownStatus
PATCH {{host}}/v1/fields/{{fieldF}}/status
Accept: {{json}}
Content-Type: {{json}}
X-API-KEY: {{apiKey}}

{
